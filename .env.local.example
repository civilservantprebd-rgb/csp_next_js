# ============================================================
# BCS One — Environment variables
# Copy this file to .env.local and fill in real values.
# ============================================================

# Supabase (from your Supabase dashboard) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED on the server. All server actions read through this key, and the
# course-videos table is RLS-protected with no policies — without this key every
# course_videos query is silently denied (videos show as unavailable).
SUPABASE_SERVICE_ROLE_KEY=

# Teacher authorization: comma-separated emails allowed to open the teacher panel
# TEACHER_EMAILS=teacher@example.com,admin@example.com

# Gemini API key used by the AI question generator (server-side only)
# GEMINI_API_KEY=your-gemini-key

# Optional contact links (Footer)
# NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yourpage