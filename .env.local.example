# Firebase Client Config (LEGACY — the app now uses Supabase; these are unused.
# Kept only as placeholders so old deployments don't break on import.)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your:web:appid
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# Supabase (from your Supabase dashboard) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (server-only — keep out of client bundles)

# Teacher authorization: comma-separated emails allowed to open the teacher panel
# TEACHER_EMAILS=teacher@example.com,admin@example.com

# Gemini API key used by the AI question generator (server-side only)
# GEMINI_API_KEY=your-gemini-key

# Optional contact links (Footer)
# NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yourpage
