rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App Configuration: Anyone can read, only authenticated admin users can modify
    match /app_config/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.endsWith('@bcsone.com');
    }

    // Exam Solutions: Strictly restricted. Only authenticated admin/teachers can read or write.
    // This prevents students from fetching the answers via client-side APIs.
    match /exam_solutions/{examId} {
      allow read, write: if request.auth != null && request.auth.token.email.endsWith('@bcsone.com');
    }

    // Allowed Students: Anyone authenticated can read to verify access, only admins can modify
    match /allowed_students/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.endsWith('@bcsone.com');
    }

    // Enrollment Requests: Students can create requests, admins can view and delete them
    match /enroll_requests/{requestId} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email.endsWith('@bcsone.com');
      allow update: if false;
    }

    // Submissions:
    // - Students can submit their answers
    // - Users can read only their own submissions
    // - Admins can read and update all submissions (for grading)
    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid || 
        request.auth.token.email.endsWith('@bcsone.com')
      );
      allow update, delete: if request.auth != null && request.auth.token.email.endsWith('@bcsone.com');
    }
  }
}
